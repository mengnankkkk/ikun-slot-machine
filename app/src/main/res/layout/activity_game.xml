<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/username_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textColor="#ffffff" />

        <TextView
            android:id="@+id/points_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:background="@drawable/points_badge"
            android:padding="8dp" />

    </LinearLayout>

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SLOT MACHINE"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFD700"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Reels Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/reels_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="12dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="8dp"
                android:background="@drawable/reel_frame">

                <ImageView
                    android:id="@+id/reel_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_camera"
                    android:padding="8dp" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="8dp"
                android:background="@drawable/reel_frame">

                <ImageView
                    android:id="@+id/reel_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_camera"
                    android:padding="8dp" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="8dp"
                android:background="@drawable/reel_frame">

                <ImageView
                    android:id="@+id/reel_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_camera"
                    android:padding="8dp" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="8dp"
                android:background="@drawable/reel_frame">

                <ImageView
                    android:id="@+id/reel_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_camera"
                    android:padding="8dp" />

            </FrameLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Buttons -->
    <Button
        android:id="@+id/spin_button"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/spin"
        android:textSize="20sp"
        android:textStyle="bold"
        android:background="@drawable/spin_button_bg"
        android:textColor="#ffffff"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/logout_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/logout"
        android:textSize="16sp"
        android:background="@drawable/logout_button_bg"
        android:textColor="#666666" />

</LinearLayout>
